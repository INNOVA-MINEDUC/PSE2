PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Solo si el frontend se sirve desde otro dominio (separados por coma)
CORS_ORIGINS=

# Cookie de sesión solo por HTTPS. Poner false únicamente en desarrollo local sin HTTPS.
COOKIE_SECURE=true

# Almacenamiento de archivos subidos: bucket (bucketService, recomendado en servidores) o local (carpeta uploads/)
# Sin STORAGE_DRIVER se usa bucket si STORAGE_SERVICE_URL tiene valor.
STORAGE_DRIVER=
STORAGE_SERVICE_URL=
STORAGE_API_KEY=
